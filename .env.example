# A2Z environment variables
# Copy this file to `.env` and fill in real keys when connecting live APIs.
# Variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle (Expo convention).
# NEVER commit a real .env file.

# --- Feature flags ---
# "mock" (default) uses the built-in mock API layer. Set to "live" once real keys are configured.
EXPO_PUBLIC_API_MODE=mock

# Keyless live data (Open-Meteo weather, OSRM road routing, Nominatim
# geocoding) is ON by default — these free APIs are called from the
# visitor's browser and need no keys. Set to "off" for deterministic demos.
EXPO_PUBLIC_LIVE_DATA=on

# --- Flights: live fares (optional) ---
# Create free self-service keys at developers.amadeus.com; without them the
# app shows calibrated estimates and the booking buttons open Google
# Flights / the airline with your real route + date pre-filled.

# --- AI Concierge (Anthropic Claude) ---
# Powers the "Curate my travel plan" briefing on the summary screen.
# Create a key at console.anthropic.com. ⚠ EXPO_PUBLIC_* keys ship in the
# browser bundle — use this for personal demos only; production should call
# Claude through a backend proxy so the key stays server-side.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# --- Weather (OpenWeather or WeatherAPI) ---
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# --- Maps & routing (Google Maps Directions API) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Flights (Amadeus or Duffel) ---
EXPO_PUBLIC_AMADEUS_CLIENT_ID=
EXPO_PUBLIC_AMADEUS_CLIENT_SECRET=
EXPO_PUBLIC_DUFFEL_API_KEY=

# --- Multimodal routing (Rome2Rio or similar) ---
EXPO_PUBLIC_ROME2RIO_API_KEY=

# --- Public transit (Transitland / GTFS) ---
EXPO_PUBLIC_TRANSITLAND_API_KEY=

# --- Rideshare (Uber / Lyft public pricing APIs, where available) ---
EXPO_PUBLIC_UBER_SERVER_TOKEN=
EXPO_PUBLIC_LYFT_CLIENT_ID=
